# Copia este archivo como .env (cp .env.example .env). Los valores sirven para desarrollo local.
DJANGO_SECRET_KEY=cambia-esta-clave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Producción (ej. PythonAnywhere) — reemplaza TUUSUARIO por tu usuario:
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<clave larga y aleatoria, ver README>
# DJANGO_ALLOWED_HOSTS=TUUSUARIO.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://TUUSUARIO.pythonanywhere.com
